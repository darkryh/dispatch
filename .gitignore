# Gradle build output and caches.
#
# These are deliberately GENERIC rather than one entry per module. The previous per-module
# enumeration silently failed the moment a module was added: dispatch-vt/build was not listed, so
# its compiled .class files were staged for commit. A generic rule covers every module, including
# ones that do not exist yet.
build/
.gradle/
.kotlin/
/*/bin/

# Initializr (standalone Kotlin/Wasm + Compose Multiplatform build).
# Ignore generated output and caches; keep sources and kotlin-js-store/ (the yarn lockfile,
# committed for reproducible CI/Pages builds).
# (covered by the generic build/ .gradle/ .kotlin/ rules above)

# Secrets — never commit signing keys or local credential files (CI uses repo secrets)
*.gpg
*.asc
secring.*
secret*.properties
*.p12
.env
.env.*

# macOS / editor cruft
.DS_Store
# IDE state and machine-local config — never source
.idea/
local.properties
**/local.properties

# Runtime/debug artifacts. These were committed in the initial import and are not sources:
# dispatch-debug.log is written by an old diagnostics path, dispatch-terminal-info.txt by a probe.
dispatch-debug.log
dispatch-terminal-info.txt

insertOrReplaceStoryDraftPreviewState:
INSERT OR REPLACE INTO story_draft_preview_state(
  chapter_id,
  status,
  proposal_id,
  before_content_ref,
  after_content_ref,
  pending_ranges_json,
  created_at,
  updated_at
) VALUES (
  :chapter_id,
  :status,
  :proposal_id,
  :before_content_ref,
  :after_content_ref,
  :pending_ranges_json,
  :created_at,
  :updated_at
);

selectStoryDraftPreviewStateByChapterId:
SELECT * FROM story_draft_preview_state
WHERE chapter_id = :chapter_id;

selectLatestStoryDraftPreviewByStoryId:
SELECT p.*
FROM story_draft_preview_state p
JOIN story_chapters c ON c.id = p.chapter_id
JOIN story_volumes v ON v.id = c.volume_id
WHERE v.story_id = :story_id
ORDER BY p.updated_at DESC
LIMIT 1;

deleteStoryDraftPreviewStateByChapterId:
DELETE FROM story_draft_preview_state
WHERE chapter_id = :chapter_id;

deleteStoryDraftPreviewStateByStoryId:
DELETE FROM story_draft_preview_state
WHERE chapter_id IN (
  SELECT c.id
  FROM story_chapters c
  JOIN story_volumes v ON v.id = c.volume_id
  WHERE v.story_id = :story_id
);


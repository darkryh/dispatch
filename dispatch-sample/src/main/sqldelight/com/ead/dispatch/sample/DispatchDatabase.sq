CREATE TABLE sessions (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  mode TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  message_count INTEGER NOT NULL,
  metadata_json TEXT
);

CREATE TABLE stories (
  id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL UNIQUE REFERENCES sessions(id) ON DELETE CASCADE,
  title TEXT,
  genre TEXT,
  setting TEXT,
  plot_outline TEXT,
  logline TEXT,
  theme TEXT,
  tone TEXT,
  stakes TEXT,
  pov TEXT,
  tense TEXT,
  target_audience TEXT,
  pacing TEXT,
  status TEXT,
  style_refs_json TEXT,
  emotional_beats_json TEXT,
  key_locations_json TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_characters (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  traits_json TEXT,
  roles_json TEXT,
  goal TEXT,
  motivation TEXT,
  flaw TEXT,
  arc TEXT,
  temperament TEXT,
  age TEXT,
  pronouns TEXT,
  occupation TEXT,
  backstory TEXT,
  voice TEXT,
  internal_conflict TEXT,
  quirks_json TEXT,
  created_at INTEGER NOT NULL
);

CREATE TABLE story_volumes (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  number INTEGER NOT NULL,
  title TEXT NOT NULL,
  summary TEXT,
  arc TEXT,
  target_word_count INTEGER,
  key_events_json TEXT,
  status TEXT,
  notes TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, number)
);

CREATE TABLE story_chapters (
  id TEXT NOT NULL PRIMARY KEY,
  volume_id TEXT NOT NULL REFERENCES story_volumes(id) ON DELETE CASCADE,
  number INTEGER NOT NULL,
  title TEXT NOT NULL,
  summary TEXT,
  content TEXT,
  content_ref TEXT,
  word_count INTEGER NOT NULL,
  pov TEXT,
  emotional_beat TEXT,
  key_events_json TEXT,
  target_word_count INTEGER,
  location TEXT,
  time_span TEXT,
  status TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(volume_id, number)
);

CREATE TABLE story_facts (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  fact_type TEXT NOT NULL CHECK (
    fact_type IN (
      'WORLD_RULE',
      'MAGIC_RULE',
      'TECH_RULE',
      'POLITICS',
      'GEOGRAPHY',
      'TIMELINE',
      'HISTORY',
      'CULTURE',
      'RELIGION',
      'ECONOMY',
      'FACTION',
      'ORGANIZATION',
      'LOCATION',
      'CHARACTER_FACT',
      'RELATIONSHIP',
      'ITEM',
      'LORE',
      'CONFLICT',
      'STAKES',
      'THEME',
      'TONE',
      'LANGUAGE',
      'CUSTOM'
    )
  ),
  content TEXT NOT NULL,
  created_at INTEGER NOT NULL
);

CREATE TABLE rag_documents (
  doc_id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
  story_id TEXT REFERENCES stories(id) ON DELETE CASCADE,
  volume_id TEXT REFERENCES story_volumes(id) ON DELETE CASCADE,
  chapter_id TEXT REFERENCES story_chapters(id) ON DELETE CASCADE,
  chunk_index INTEGER NOT NULL,
  source_type TEXT NOT NULL,
  source_ref TEXT,
  checksum TEXT,
  created_at INTEGER NOT NULL
);

CREATE INDEX sessions_updated_at_idx ON sessions(updated_at);
CREATE INDEX stories_session_id_idx ON stories(session_id);
CREATE INDEX story_volumes_story_id_idx ON story_volumes(story_id);
CREATE INDEX story_chapters_volume_id_idx ON story_chapters(volume_id);
CREATE INDEX rag_documents_session_id_idx ON rag_documents(session_id);
CREATE INDEX rag_documents_story_id_idx ON rag_documents(story_id);
CREATE INDEX rag_documents_chapter_id_idx ON rag_documents(chapter_id);

insertSession:
INSERT INTO sessions(
  id,
  title,
  mode,
  created_at,
  updated_at,
  message_count,
  metadata_json
) VALUES (
  :id,
  :title,
  :mode,
  :created_at,
  :updated_at,
  :message_count,
  :metadata_json
);

updateSession:
UPDATE sessions
SET title = :title,
    mode = :mode,
    updated_at = :updated_at,
    message_count = :message_count,
    metadata_json = :metadata_json
WHERE id = :id;

selectSessionById:
SELECT * FROM sessions
WHERE id = :id;

selectSessions:
SELECT * FROM sessions
ORDER BY updated_at DESC;

deleteSession:
DELETE FROM sessions
WHERE id = :id;


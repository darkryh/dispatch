ORDER BY number ASC;

selectSceneById:
SELECT * FROM story_scenes
WHERE id = :id;

insertStorySceneKeyEvent:
INSERT OR REPLACE INTO story_scene_key_events(
  scene_id,
  position,
  value
) VALUES (
  :scene_id,
  :position,
  :value
);

deleteStorySceneKeyEventsBySceneId:
DELETE FROM story_scene_key_events
WHERE scene_id = :scene_id;

deleteStorySceneKeyEventsByChapterId:
DELETE FROM story_scene_key_events
WHERE scene_id IN (
  SELECT id FROM story_scenes WHERE chapter_id = :chapter_id
);

selectStorySceneKeyEventsBySceneId:
SELECT * FROM story_scene_key_events
WHERE scene_id = :scene_id
ORDER BY position ASC;


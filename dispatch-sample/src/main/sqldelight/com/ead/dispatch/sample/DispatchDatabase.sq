CREATE TABLE sessions (
  id TEXT NOT NULL PRIMARY KEY,
  title TEXT NOT NULL,
  mode TEXT NOT NULL CHECK (
    mode IN ('CHAT', 'CHAT_STORY')
  ),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  message_count INTEGER NOT NULL
);

CREATE TABLE session_metadata (
  session_id TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
  key TEXT NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (session_id, key)
);

CREATE TABLE stories (
  id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL UNIQUE REFERENCES sessions(id) ON DELETE CASCADE,
  title TEXT,
  genre TEXT,
  setting TEXT,
  plot_outline TEXT,
  logline TEXT,
  theme TEXT,
  tone TEXT,
  stakes TEXT,
  pov TEXT,
  tense TEXT,
  target_audience TEXT,
  pacing TEXT,
  status TEXT CHECK (
    status IN ('DRAFT', 'IN_PROGRESS', 'FINAL', 'ARCHIVED')
  ),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_style_refs (
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (story_id, position)
);

CREATE TABLE story_emotional_beats (
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (story_id, position)
);

CREATE TABLE story_characters (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  goal TEXT,
  motivation TEXT,
  flaw TEXT,
  temperament TEXT,
  age TEXT,
  pronouns TEXT,
  occupation TEXT,
  backstory TEXT,
  voice TEXT,
  internal_conflict TEXT,
  appearance TEXT,
  height TEXT,
  build TEXT,
  hair TEXT,
  eyes TEXT,
  skin_tone TEXT,
  distinguishing_marks TEXT,
  style_notes TEXT,
  created_at INTEGER NOT NULL,
  UNIQUE(story_id, name)
);

CREATE TABLE story_character_traits (
  character_id TEXT NOT NULL REFERENCES story_characters(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (character_id, position)
);

CREATE TABLE story_character_roles (
  character_id TEXT NOT NULL REFERENCES story_characters(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (character_id, position)
);

CREATE TABLE story_character_quirks (
  character_id TEXT NOT NULL REFERENCES story_characters(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (character_id, position)
);

CREATE TABLE story_volumes (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  number INTEGER NOT NULL CHECK (number >= 1),
  title TEXT NOT NULL,
  summary TEXT,
  target_word_count INTEGER CHECK (target_word_count IS NULL OR target_word_count >= 0),
  status TEXT CHECK (
    status IN ('DRAFT', 'IN_PROGRESS', 'FINAL', 'ARCHIVED')
  ),
  notes TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, number)
);

CREATE TABLE story_volume_key_events (
  volume_id TEXT NOT NULL REFERENCES story_volumes(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (volume_id, position)
);

CREATE TABLE story_chapters (
  id TEXT NOT NULL PRIMARY KEY,
  volume_id TEXT NOT NULL REFERENCES story_volumes(id) ON DELETE CASCADE,
  number INTEGER NOT NULL CHECK (number >= 1),
  title TEXT NOT NULL,
  summary TEXT,
  content_ref TEXT,
  content_type TEXT CHECK (
    content_type IN ('MARKDOWN', 'DOCX', 'PDF', 'TEXT')
  ),
  content_checksum TEXT,
  content_updated_at INTEGER,
  content_range TEXT,
  word_count INTEGER CHECK (word_count IS NULL OR word_count >= 0),
  target_word_count INTEGER CHECK (target_word_count IS NULL OR target_word_count >= 0),
  status TEXT CHECK (
    status IN ('DRAFT', 'IN_PROGRESS', 'FINAL', 'ARCHIVED')
  ),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(volume_id, number)
);

CREATE TABLE story_draft_current (
  chapter_id TEXT NOT NULL PRIMARY KEY REFERENCES story_chapters(id) ON DELETE CASCADE,
  content_ref TEXT NOT NULL,
  checksum TEXT NOT NULL,
  word_count INTEGER NOT NULL CHECK (word_count >= 0),
  updated_at INTEGER NOT NULL,
  updated_by TEXT
);

CREATE TABLE story_draft_versions (
  id TEXT NOT NULL PRIMARY KEY,
  chapter_id TEXT NOT NULL REFERENCES story_chapters(id) ON DELETE CASCADE,
  content_ref TEXT NOT NULL,
  checksum TEXT NOT NULL,
  word_count INTEGER NOT NULL CHECK (word_count >= 0),
  created_at INTEGER NOT NULL,
  note TEXT,
  source TEXT
);

CREATE TABLE story_draft_proposals (
  id TEXT NOT NULL PRIMARY KEY,
  chapter_id TEXT NOT NULL REFERENCES story_chapters(id) ON DELETE CASCADE,
  base_checksum TEXT NOT NULL,
  base_content_ref TEXT NOT NULL,
  candidate_content_ref TEXT NOT NULL,
  candidate_checksum TEXT NOT NULL,
  operation_count INTEGER NOT NULL CHECK (operation_count >= 0),
  status TEXT NOT NULL CHECK (
    status IN ('PENDING', 'APPLIED', 'REJECTED', 'EXPIRED')
  ),
  created_at INTEGER NOT NULL,
  decided_at INTEGER,
  note TEXT
);

CREATE TABLE story_draft_preview_state (
  chapter_id TEXT NOT NULL PRIMARY KEY REFERENCES story_chapters(id) ON DELETE CASCADE,
  status TEXT NOT NULL CHECK (
    status IN ('PENDING', 'APPLIED', 'REJECTED')
  ),
  proposal_id TEXT,
  before_content_ref TEXT NOT NULL,
  after_content_ref TEXT NOT NULL,
  pending_ranges_json TEXT NOT NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_chapter_memory (
  chapter_id TEXT NOT NULL PRIMARY KEY REFERENCES story_chapters(id) ON DELETE CASCADE,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  approved_checksum TEXT NOT NULL,
  summary_short TEXT NOT NULL,
  key_beats_json TEXT NOT NULL,
  entities_json TEXT NOT NULL,
  unresolved_threads_json TEXT NOT NULL,
  pov TEXT,
  tense TEXT,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_continuity_memory (
  story_id TEXT NOT NULL PRIMARY KEY REFERENCES stories(id) ON DELETE CASCADE,
  rolling_summary TEXT NOT NULL,
  active_threads_json TEXT NOT NULL,
  continuity_warnings_json TEXT NOT NULL,
  last_chapter_ids_json TEXT NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_chapter_key_events (
  chapter_id TEXT NOT NULL REFERENCES story_chapters(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (chapter_id, position)
);

CREATE TABLE story_locations (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  created_at INTEGER NOT NULL,
  UNIQUE(story_id, name)
);

CREATE TABLE story_location_tags (
  location_id TEXT NOT NULL REFERENCES story_locations(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (location_id, position)
);

CREATE TABLE story_arcs (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  scope_type TEXT NOT NULL CHECK (
    scope_type IN ('STORY', 'VOLUME', 'CHAPTER', 'SCENE', 'CHARACTER')
  ),
  scope_id TEXT,
  title TEXT NOT NULL,
  summary TEXT,
  status TEXT CHECK (
    status IN ('DRAFT', 'IN_PROGRESS', 'FINAL', 'ARCHIVED')
  ),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_scenes (
  id TEXT NOT NULL PRIMARY KEY,
  chapter_id TEXT NOT NULL REFERENCES story_chapters(id) ON DELETE CASCADE,
  number INTEGER NOT NULL CHECK (number >= 1),
  title TEXT,
  summary TEXT,
  content_range TEXT,
  pov TEXT,
  emotional_beat TEXT,
  location_id TEXT REFERENCES story_locations(id) ON DELETE SET NULL,
  time_span TEXT,
  status TEXT CHECK (
    status IN ('DRAFT', 'IN_PROGRESS', 'FINAL', 'ARCHIVED')
  ),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(chapter_id, number)
);

CREATE TABLE story_scene_characters (
  scene_id TEXT NOT NULL REFERENCES story_scenes(id) ON DELETE CASCADE,
  character_id TEXT NOT NULL REFERENCES story_characters(id) ON DELETE CASCADE,
  role TEXT,
  notes TEXT,
  PRIMARY KEY (scene_id, character_id)
);

CREATE TABLE story_scene_entities (
  scene_id TEXT NOT NULL REFERENCES story_scenes(id) ON DELETE CASCADE,
  entity_id TEXT NOT NULL,
  entity_type TEXT NOT NULL CHECK (
    entity_type IN ('CHARACTER', 'LOCATION', 'ORGANIZATION', 'ARTIFACT', 'EVENT', 'CULTURE', 'WORLD_RULE', 'TIMELINE')
  ),
  role TEXT,
  notes TEXT,
  PRIMARY KEY (scene_id, entity_type, entity_id)
);

CREATE TABLE story_scene_key_events (
  scene_id TEXT NOT NULL REFERENCES story_scenes(id) ON DELETE CASCADE,
  position INTEGER NOT NULL,
  value TEXT NOT NULL,
  PRIMARY KEY (scene_id, position)
);

CREATE TABLE story_world_rules (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  description TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, title)
);

CREATE TABLE story_cultures (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, name)
);

CREATE TABLE story_events (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, name)
);

CREATE TABLE story_organizations (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, name)
);

CREATE TABLE story_relationships (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  subject_id TEXT NOT NULL,
  subject_type TEXT NOT NULL,
  object_id TEXT NOT NULL,
  object_type TEXT NOT NULL,
  relation TEXT NOT NULL,
  notes TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  CHECK (
    subject_type IN ('CHARACTER', 'LOCATION', 'ORGANIZATION', 'ARTIFACT', 'EVENT', 'CULTURE', 'WORLD_RULE', 'TIMELINE')
  ),
  CHECK (
    object_type IN ('CHARACTER', 'LOCATION', 'ORGANIZATION', 'ARTIFACT', 'EVENT', 'CULTURE', 'WORLD_RULE', 'TIMELINE')
  )
);

CREATE TABLE story_location_features (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  location_id TEXT REFERENCES story_locations(id) ON DELETE SET NULL,
  name TEXT NOT NULL,
  description TEXT,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_artifacts (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  name TEXT NOT NULL,
  description TEXT,
  owner_id TEXT,
  owner_type TEXT CHECK (
    owner_type IS NULL OR owner_type IN ('CHARACTER', 'LOCATION', 'ORGANIZATION', 'ARTIFACT', 'EVENT', 'CULTURE', 'WORLD_RULE', 'TIMELINE')
  ),
  location_id TEXT REFERENCES story_locations(id) ON DELETE SET NULL,
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL
);

CREATE TABLE story_timeline_entries (
  id TEXT NOT NULL PRIMARY KEY,
  story_id TEXT NOT NULL REFERENCES stories(id) ON DELETE CASCADE,
  title TEXT NOT NULL,
  description TEXT,
  order_index INTEGER NOT NULL CHECK (order_index >= 1),
  created_at INTEGER NOT NULL,
  updated_at INTEGER NOT NULL,
  UNIQUE(story_id, order_index)
);

CREATE TABLE rag_documents (
  doc_id TEXT NOT NULL PRIMARY KEY,
  session_id TEXT NOT NULL REFERENCES sessions(id) ON DELETE CASCADE,
  story_id TEXT REFERENCES stories(id) ON DELETE CASCADE,
  volume_id TEXT REFERENCES story_volumes(id) ON DELETE CASCADE,
  chapter_id TEXT REFERENCES story_chapters(id) ON DELETE CASCADE,
  chunk_index INTEGER NOT NULL,
  source_type TEXT NOT NULL CHECK (
    source_type IN ('FILE', 'CHAT', 'NOTE')
  ),
  source_ref TEXT,
  checksum TEXT,
  created_at INTEGER NOT NULL
);

CREATE INDEX sessions_updated_at_idx ON sessions(updated_at);
CREATE INDEX stories_session_id_idx ON stories(session_id);
CREATE INDEX story_volumes_story_id_idx ON story_volumes(story_id);
CREATE INDEX story_chapters_volume_id_idx ON story_chapters(volume_id);
CREATE INDEX story_draft_current_updated_idx ON story_draft_current(updated_at DESC);
CREATE INDEX story_draft_versions_chapter_created_idx ON story_draft_versions(chapter_id, created_at DESC);
CREATE INDEX story_draft_proposals_chapter_status_created_idx ON story_draft_proposals(chapter_id, status, created_at DESC);
CREATE INDEX story_draft_preview_state_updated_idx ON story_draft_preview_state(updated_at DESC);
CREATE INDEX story_chapter_memory_story_updated_idx ON story_chapter_memory(story_id, updated_at DESC);
CREATE INDEX story_chapter_memory_chapter_updated_idx ON story_chapter_memory(chapter_id, updated_at DESC);
CREATE INDEX story_locations_story_id_idx ON story_locations(story_id);
CREATE INDEX story_arcs_story_id_idx ON story_arcs(story_id);
CREATE INDEX story_arcs_scope_idx ON story_arcs(scope_type, scope_id);
CREATE INDEX story_scenes_chapter_id_idx ON story_scenes(chapter_id);
CREATE INDEX story_scenes_location_id_idx ON story_scenes(location_id);
CREATE INDEX story_world_rules_story_updated_idx ON story_world_rules(story_id, updated_at DESC);
CREATE INDEX story_cultures_story_updated_idx ON story_cultures(story_id, updated_at DESC);
CREATE INDEX story_events_story_updated_idx ON story_events(story_id, updated_at DESC);
CREATE INDEX story_organizations_story_updated_idx ON story_organizations(story_id, updated_at DESC);
CREATE INDEX story_relationships_story_updated_idx ON story_relationships(story_id, updated_at DESC);
CREATE INDEX story_location_features_story_updated_idx ON story_location_features(story_id, updated_at DESC);
CREATE INDEX story_artifacts_story_updated_idx ON story_artifacts(story_id, updated_at DESC);
CREATE INDEX story_timeline_entries_story_updated_idx ON story_timeline_entries(story_id, updated_at DESC);
CREATE INDEX rag_documents_session_id_idx ON rag_documents(session_id);
CREATE INDEX rag_documents_story_id_idx ON rag_documents(story_id);
CREATE INDEX rag_documents_chapter_id_idx ON rag_documents(chapter_id);

insertSession:
INSERT INTO sessions(
  id,
  title,
  mode,
  created_at,
  updated_at,
  message_count
) VALUES (
  :id,
  :title,
  :mode,
  :created_at,
  :updated_at,
  :message_count
);

updateSession:
UPDATE sessions
SET title = :title,
    mode = :mode,
    updated_at = :updated_at,
    message_count = :message_count
WHERE id = :id;

selectSessionById:
SELECT * FROM sessions
WHERE id = :id;

selectSessions:
SELECT * FROM sessions
ORDER BY updated_at DESC;

insertSessionMetadata:
INSERT INTO session_metadata(
  session_id,
  key,
  value
) VALUES (
  :session_id,
  :key,
  :value
);

selectSessionMetadataBySessionId:
SELECT * FROM session_metadata
WHERE session_id = :session_id
ORDER BY key ASC;

deleteSessionMetadataBySessionId:
DELETE FROM session_metadata
WHERE session_id = :session_id;

deleteSession:
DELETE FROM sessions
WHERE id = :id;

insertStory:
INSERT INTO stories(
  id,
  session_id,
  title,
  genre,
  setting,
  plot_outline,
  logline,
  theme,
  tone,
  stakes,
  pov,
  tense,
  target_audience,
  pacing,
  status,
  created_at,
  updated_at
) VALUES (
  :id,
  :session_id,
  :title,
  :genre,
  :setting,
  :plot_outline,
  :logline,
  :theme,
  :tone,
  :stakes,
  :pov,
  :tense,
  :target_audience,
  :pacing,
  :status,
  :created_at,
  :updated_at
);

updateStory:
UPDATE stories
SET title = :title,
    genre = :genre,
    setting = :setting,
    plot_outline = :plot_outline,
    logline = :logline,
    theme = :theme,
    tone = :tone,
    stakes = :stakes,
    pov = :pov,
    tense = :tense,
    target_audience = :target_audience,
    pacing = :pacing,
    status = :status,
    updated_at = :updated_at
WHERE id = :id;

selectStoryById:
SELECT * FROM stories
WHERE id = :id;

selectStoriesBySessionId:
SELECT * FROM stories
WHERE session_id = :session_id
ORDER BY updated_at DESC;

insertStoryStyleRef:
INSERT INTO story_style_refs(
  story_id,
  position,
  value
) VALUES (
  :story_id,
  :position,
  :value
);

deleteStoryStyleRefsByStoryId:
DELETE FROM story_style_refs
WHERE story_id = :story_id;

selectStoryStyleRefsByStoryId:
SELECT * FROM story_style_refs
WHERE story_id = :story_id
ORDER BY position ASC;

insertStoryEmotionalBeat:
INSERT INTO story_emotional_beats(
  story_id,
  position,
  value
) VALUES (
  :story_id,
  :position,
  :value
);

deleteStoryEmotionalBeatsByStoryId:
DELETE FROM story_emotional_beats
WHERE story_id = :story_id;

selectStoryEmotionalBeatsByStoryId:
SELECT * FROM story_emotional_beats
WHERE story_id = :story_id
ORDER BY position ASC;

deleteStory:
DELETE FROM stories
WHERE id = :id;

insertStoryCharacter:
INSERT INTO story_characters(
  id,
  story_id,
  name,
  description,
  goal,
  motivation,
  flaw,
  temperament,
  age,
  pronouns,
  occupation,
  backstory,
  voice,
  internal_conflict,
  appearance,
  height,
  build,
  hair,
  eyes,
  skin_tone,
  distinguishing_marks,
  style_notes,
  created_at
) VALUES (
  :id,
  :story_id,
  :name,
  :description,
  :goal,
  :motivation,
  :flaw,
  :temperament,
  :age,
  :pronouns,
  :occupation,
  :backstory,
  :voice,
  :internal_conflict,
  :appearance,
  :height,
  :build,
  :hair,
  :eyes,
  :skin_tone,
  :distinguishing_marks,
  :style_notes,
  :created_at
);

updateStoryCharacter:
UPDATE story_characters SET
  name = :name,
  description = :description,
  goal = :goal,
  motivation = :motivation,
  flaw = :flaw,
  temperament = :temperament,
  age = :age,
  pronouns = :pronouns,
  occupation = :occupation,
  backstory = :backstory,
  voice = :voice,
  internal_conflict = :internal_conflict,
  appearance = :appearance,
  height = :height,
  build = :build,
  hair = :hair,
  eyes = :eyes,
  skin_tone = :skin_tone,
  distinguishing_marks = :distinguishing_marks,
  style_notes = :style_notes
WHERE id = :id
  AND story_id = :story_id;

deleteStoryCharacterById:
DELETE FROM story_characters
WHERE id = :id
  AND story_id = :story_id;

deleteStoryCharactersByStoryId:
DELETE FROM story_characters
WHERE story_id = :story_id;

deleteStoryCharacterTraitsByStoryId:
DELETE FROM story_character_traits
WHERE character_id IN (
  SELECT id FROM story_characters WHERE story_id = :story_id
);

deleteStoryCharacterRolesByStoryId:
DELETE FROM story_character_roles
WHERE character_id IN (
  SELECT id FROM story_characters WHERE story_id = :story_id
);

deleteStoryCharacterQuirksByStoryId:
DELETE FROM story_character_quirks
WHERE character_id IN (
  SELECT id FROM story_characters WHERE story_id = :story_id
);

selectCharactersByStoryId:
SELECT * FROM story_characters
WHERE story_id = :story_id
ORDER BY name ASC;

selectCharacterIdByStoryAndId:
SELECT id FROM story_characters
WHERE story_id = :story_id
  AND id = :id;

insertStoryCharacterTrait:
INSERT OR REPLACE INTO story_character_traits(
  character_id,
  position,
  value
) VALUES (
  :character_id,
  :position,
  :value
);

deleteStoryCharacterTraitsByCharacterId:
DELETE FROM story_character_traits
WHERE character_id = :character_id;

selectStoryCharacterTraitsByCharacterId:
SELECT * FROM story_character_traits
WHERE character_id = :character_id
ORDER BY position ASC;

insertStoryCharacterRole:
INSERT OR REPLACE INTO story_character_roles(
  character_id,
  position,
  value
) VALUES (
  :character_id,
  :position,
  :value
);

deleteStoryCharacterRolesByCharacterId:
DELETE FROM story_character_roles
WHERE character_id = :character_id;

selectStoryCharacterRolesByCharacterId:
SELECT * FROM story_character_roles
WHERE character_id = :character_id
ORDER BY position ASC;

insertStoryCharacterQuirk:
INSERT OR REPLACE INTO story_character_quirks(
  character_id,
  position,
  value
) VALUES (
  :character_id,
  :position,
  :value
);

deleteStoryCharacterQuirksByCharacterId:
DELETE FROM story_character_quirks
WHERE character_id = :character_id;

selectStoryCharacterQuirksByCharacterId:
SELECT * FROM story_character_quirks
WHERE character_id = :character_id
ORDER BY position ASC;

insertStoryVolume:
INSERT INTO story_volumes(
  id,
  story_id,
  number,
  title,
  summary,
  target_word_count,
  status,
  notes,
  created_at,
  updated_at
) VALUES (
  :id,
  :story_id,
  :number,
  :title,
  :summary,
  :target_word_count,
  :status,
  :notes,
  :created_at,
  :updated_at
);

updateStoryVolume:
UPDATE story_volumes
SET title = :title,
    summary = :summary,
    target_word_count = :target_word_count,
    status = :status,
    notes = :notes,
    updated_at = :updated_at
WHERE id = :id;

selectVolumesByStoryId:
SELECT * FROM story_volumes
WHERE story_id = :story_id
ORDER BY number ASC;

selectVolumeById:
SELECT * FROM story_volumes
WHERE id = :id;

insertStoryVolumeKeyEvent:
INSERT INTO story_volume_key_events(
  volume_id,
  position,
  value
) VALUES (
  :volume_id,
  :position,
  :value
);

deleteStoryVolumeKeyEventsByVolumeId:
DELETE FROM story_volume_key_events
WHERE volume_id = :volume_id;

selectStoryVolumeKeyEventsByVolumeId:
SELECT * FROM story_volume_key_events
WHERE volume_id = :volume_id
ORDER BY position ASC;

deleteStoryVolume:
DELETE FROM story_volumes
WHERE id = :id;

insertStoryChapter:
INSERT INTO story_chapters(
  id,
  volume_id,
  number,
  title,
  summary,
  content_ref,
  content_type,
  content_checksum,
  content_updated_at,
  content_range,
  word_count,
  target_word_count,
  status,
  created_at,
  updated_at
) VALUES (
  :id,
  :volume_id,
  :number,
  :title,
  :summary,
  :content_ref,
  :content_type,
  :content_checksum,
  :content_updated_at,
  :content_range,
  :word_count,
  :target_word_count,
  :status,
  :created_at,
  :updated_at
);

updateStoryChapter:
UPDATE story_chapters
SET title = :title,
    summary = :summary,
    content_ref = :content_ref,
    content_type = :content_type,
    content_checksum = :content_checksum,
    content_updated_at = :content_updated_at,
    content_range = :content_range,
    word_count = :word_count,
    target_word_count = :target_word_count,
    status = :status,
    updated_at = :updated_at
WHERE id = :id;


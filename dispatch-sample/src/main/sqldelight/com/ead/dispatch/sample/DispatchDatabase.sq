insertRagDocument:
INSERT INTO rag_documents(
  doc_id,
  session_id,
  story_id,
  volume_id,
  chapter_id,
  chunk_index,
  source_type,
  source_ref,
  checksum,
  created_at
) VALUES (
  :doc_id,
  :session_id,
  :story_id,
  :volume_id,
  :chapter_id,
  :chunk_index,
  :source_type,
  :source_ref,
  :checksum,
  :created_at
);

selectRagDocumentsBySessionId:
SELECT * FROM rag_documents
WHERE session_id = :session_id
ORDER BY created_at DESC;

selectRagDocumentsByStoryId:
SELECT * FROM rag_documents
WHERE story_id = :story_id
ORDER BY created_at DESC;

selectRagDocumentsBySourceRef:
SELECT * FROM rag_documents
WHERE source_ref = :source_ref
ORDER BY created_at DESC;

selectRagDocumentsByStoryAndSourceRef:
SELECT * FROM rag_documents
WHERE story_id = :story_id
  AND source_ref = :source_ref
ORDER BY created_at DESC;

selectRagDocumentsByChapterId:
SELECT * FROM rag_documents
WHERE chapter_id = :chapter_id
ORDER BY chunk_index ASC;

deleteRagDocumentById:
DELETE FROM rag_documents
WHERE doc_id = :doc_id;

deleteRagDocumentsBySourceRef:
DELETE FROM rag_documents
WHERE source_ref = :source_ref;

deleteRagDocumentsByStoryAndSourceRef:
DELETE FROM rag_documents
WHERE story_id = :story_id
  AND source_ref = :source_ref;

deleteRagDocumentsByChapterId:
DELETE FROM rag_documents
WHERE chapter_id = :chapter_id;

INSERT INTO story_location_tags(
  location_id,
  position,
  value
) VALUES (
  :location_id,
  :position,
  :value
);

deleteStoryLocationTagsByLocationId:
DELETE FROM story_location_tags
WHERE location_id = :location_id;

deleteStoryLocationTagsByStoryId:
DELETE FROM story_location_tags
WHERE location_id IN (
  SELECT id
  FROM story_locations
  WHERE story_id = :story_id
);

selectStoryLocationTagsByLocationId:
SELECT * FROM story_location_tags
WHERE location_id = :location_id
ORDER BY position ASC;

deleteLocationsByStoryId:
DELETE FROM story_locations
WHERE story_id = :story_id;


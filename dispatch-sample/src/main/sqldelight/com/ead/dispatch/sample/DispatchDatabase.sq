  AND chapter_id = :chapter_id;

deleteStoryDraftVersionsOutsideLimit:
DELETE FROM story_draft_versions
WHERE chapter_id = :chapter_id
  AND id NOT IN (
    SELECT id
    FROM story_draft_versions
    WHERE chapter_id = :chapter_id
    ORDER BY created_at DESC
    LIMIT :keep_limit
  );


deleteStoryCharacterById:
DELETE FROM story_characters
WHERE id = :id;

deleteStoryCharactersByStoryId:
DELETE FROM story_characters
WHERE story_id = :story_id;

deleteStoryCharacterTraitsByStoryId:
DELETE FROM story_character_traits
WHERE character_id IN (
  SELECT id FROM story_characters WHERE story_id = :story_id
);

deleteStoryCharacterRolesByStoryId:
DELETE FROM story_character_roles
WHERE character_id IN (
  SELECT id FROM story_characters WHERE story_id = :story_id
);

deleteStoryCharacterQuirksByStoryId:
DELETE FROM story_character_quirks
WHERE character_id IN (
  SELECT id FROM story_characters WHERE story_id = :story_id
);

selectCharactersByStoryId:
SELECT * FROM story_characters
WHERE story_id = :story_id
ORDER BY name ASC;


WHERE story_id = :story_id
ORDER BY created_at ASC;

selectArcsByScope:
SELECT * FROM story_arcs
WHERE scope_type = :scope_type
  AND scope_id = :scope_id
ORDER BY created_at ASC;

selectArcById:
SELECT * FROM story_arcs
WHERE id = :id;

deleteStoryArcById:
